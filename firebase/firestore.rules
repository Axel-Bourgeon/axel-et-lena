rules_version = '2';

// Espace du couple : /couples/{code}, avec ses sous-collections (alertes,
// agenda bébé, notes). Le code (10 caractères aléatoires) n'est connu que des
// deux téléphones ; la liste des espaces n'est jamais lisible.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(code) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(code)).data.members;
    }

    match /couples/{code} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if false;

      // Création : on en est le seul membre.
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && code.size() == 10;

      // Un membre peut tout modifier ; quelqu'un qui connaît le code peut
      // seulement s'ajouter à la liste des membres (rejoindre l'espace).
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && resource.data.members.size() < 6
        )
      );
      allow delete: if false;

      match /{document=**} {
        allow read, write: if isMember(code);
      }
    }
  }
}
